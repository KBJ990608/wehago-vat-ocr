{
  "name": "wehago-vat-ocr",
  "productName": "WEHAGO VAT OCR",
  "version": "1.0.0",
  "description": "WEHAGO VAT OCR desktop app",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
